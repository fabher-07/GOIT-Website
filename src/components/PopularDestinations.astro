---
const destinations = [
  { 
    city: 'CDMX', 
    from: 'Centro Histórico', 
    to: 'Aeropuerto', 
    price: 'desde $180', 
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>'
  },
  { 
    city: 'Guadalajara', 
    from: 'Centro', 
    to: 'Zapopan', 
    price: 'desde $95', 
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>'
  },
  { 
    city: 'Monterrey', 
    from: 'Centro', 
    to: 'San Pedro', 
    price: 'desde $110', 
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>'
  },
  { 
    city: 'Puebla', 
    from: 'Angelópolis', 
    to: 'Centro', 
    price: 'desde $85', 
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>'
  },
];
---

<section class="py-16 lg:py-24 bg-gradient-to-b from-black via-gray-900 to-black relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary rounded-full blur-[120px]"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-primary rounded-full blur-[120px]"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="fade-up text-3xl sm:text-4xl lg:text-5xl font-black text-white mb-4">
        Ejemplos de tarifas en <span class="text-primary">todo México</span>
      </h2>
      <p class="fade-up text-lg text-gray-400 max-w-2xl mx-auto" style="transition-delay: 0.1s;">
        Tarifas justas y transparentes en las principales ciudades del país
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {destinations.map((dest, index) => (
        <div 
          class="fade-up bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:bg-white/10 hover:border-primary/50 transition-all duration-300 group"
          style={`transition-delay: ${index * 0.1}s;`}
        >
          <div class="text-primary mb-4 group-hover:scale-110 transition-transform" set:html={dest.icon}></div>
          <h3 class="text-xl font-bold text-white mb-2">{dest.city}</h3>
          <div class="space-y-2 mb-4">
            <div class="flex items-center gap-2 text-sm text-gray-400">
              <div class="w-2 h-2 bg-primary rounded-full"></div>
              <span>{dest.from}</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-gray-400">
              <div class="w-2 h-2 bg-white rounded-full"></div>
              <span>{dest.to}</span>
            </div>
          </div>
          <div class="text-2xl font-black text-primary">{dest.price}</div>
        </div>
      ))}
    </div>

    <p class="fade-up text-center text-sm text-gray-500 mt-8" style="transition-delay: 0.4s;">
      *Tarifas estimadas. Pueden variar según ciudad, distancia y condiciones de tráfico
    </p>
  </div>
</section>
