---
const destinations = [
  { city: 'CDMX', from: 'Centro Histórico', to: 'Aeropuerto', price: 'desde $180', icon: '✈️' },
  { city: 'Guadalajara', from: 'Centro', to: 'Zapopan', price: 'desde $95', icon: '🏛️' },
  { city: 'Monterrey', from: 'Centro', to: 'San Pedro', price: 'desde $110', icon: '🏔️' },
  { city: 'Puebla', from: 'Angelópolis', to: 'Centro', price: 'desde $85', icon: '🎨' },
];
---

<section class="py-16 lg:py-24 bg-gradient-to-b from-black via-gray-900 to-black relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary rounded-full blur-[120px]"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-primary rounded-full blur-[120px]"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="fade-up text-3xl sm:text-4xl lg:text-5xl font-black text-white mb-4">
        Ejemplos de tarifas en <span class="text-primary">todo México</span>
      </h2>
      <p class="fade-up text-lg text-gray-400 max-w-2xl mx-auto" style="transition-delay: 0.1s;">
        Tarifas justas y transparentes en las principales ciudades del país
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {destinations.map((dest, index) => (
        <div 
          class="fade-up bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:bg-white/10 hover:border-primary/50 transition-all duration-300 group"
          style={`transition-delay: ${index * 0.1}s;`}
        >
          <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">{dest.icon}</div>
          <h3 class="text-xl font-bold text-white mb-2">{dest.city}</h3>
          <div class="space-y-2 mb-4">
            <div class="flex items-center gap-2 text-sm text-gray-400">
              <div class="w-2 h-2 bg-primary rounded-full"></div>
              <span>{dest.from}</span>
            </div>
            <div class="flex items-center gap-2 text-sm text-gray-400">
              <div class="w-2 h-2 bg-white rounded-full"></div>
              <span>{dest.to}</span>
            </div>
          </div>
          <div class="text-2xl font-black text-primary">{dest.price}</div>
        </div>
      ))}
    </div>

    <p class="fade-up text-center text-sm text-gray-500 mt-8" style="transition-delay: 0.4s;">
      *Tarifas estimadas. Pueden variar según ciudad, distancia y condiciones de tráfico
    </p>
  </div>
</section>
