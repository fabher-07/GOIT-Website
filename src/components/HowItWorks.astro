---
const steps = [
  {
    number: '01',
    title: 'Pide tu taxi',
    description: 'Abre la app, ingresa tu destino y solicita un taxi legal en segundos.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>`,
  },
  {
    number: '02',
    title: 'Te conectamos con un taxista',
    description: 'Un taxista con concesión oficial y documentos en regla acepta tu solicitud al instante.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  },
  {
    number: '03',
    title: 'Llega seguro a tu destino',
    description: 'Viájalo con la tranquilidad de ir con un profesional del volante. Paga fácil al finalizar.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
];
---

<section id="como-funciona" class="py-20 lg:py-32 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16 lg:mb-20">
      <div class="fade-up inline-flex items-center gap-2 bg-primary/10 text-black px-4 py-2 rounded-full text-sm font-semibold mb-4">
        <span class="w-2 h-2 bg-primary rounded-full"></span>
        Simple y confiable
      </div>
      <h2 class="fade-up text-3xl sm:text-4xl lg:text-5xl font-black text-black mb-4" style="transition-delay: 0.1s;">
        Así de fácil es viajar con Ride
      </h2>
      <p class="fade-up text-lg text-gray-500 max-w-2xl mx-auto" style="transition-delay: 0.2s;">
        En 3 pasos te conectamos con un taxista legal y de confianza
      </p>
    </div>

    <!-- Steps -->
    <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
      {steps.map((step, index) => (
        <div class="fade-up relative group" style={`transition-delay: ${index * 0.15}s;`}>
          {/* Connector line */}
          {index < steps.length - 1 && (
            <div class="hidden md:block absolute top-16 left-[60%] w-[80%] h-0.5 bg-gradient-to-r from-primary to-primary/20"></div>
          )}

          <div class="relative bg-gray-50 rounded-3xl p-8 lg:p-10 hover:bg-primary/5 transition-all duration-300 group-hover:-translate-y-2 border border-gray-100 group-hover:border-primary/20">
            <!-- Number -->
            <div class="text-6xl font-black text-primary/15 absolute top-4 right-6">{step.number}</div>

            <!-- Icon -->
            <div class="w-16 h-16 bg-primary rounded-2xl flex items-center justify-center mb-6 text-black group-hover:scale-110 transition-transform">
              <Fragment set:html={step.icon} />
            </div>

            <h3 class="text-xl font-bold text-black mb-3">{step.title}</h3>
            <p class="text-gray-500 leading-relaxed">{step.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
