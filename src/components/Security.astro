---
const features = [
  {
    title: 'Taxistas con concesión oficial',
    description: 'Solo taxistas legalmente registrados en el sistema oficial de México. Verificamos concesión, identidad, antecedentes y documentos del vehículo.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  },
  {
    title: 'Cada viaje rastreado en tiempo real',
    description: 'Monitoreo en tiempo real de cada recorrido. Comparte tu ruta con tu familia para que siempre sepan dónde estás.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  },
  {
    title: 'Botón de emergencia',
    description: 'Acceso inmediato a servicios de emergencia desde la app. Tu seguridad nunca está a más de un toque de distancia.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>`,
  },
  {
    title: 'Calificaciones mutuas',
    description: 'Pasajeros y taxistas se califican mutuamente. Un sistema justo que premia el buen servicio y la buena convivencia.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>`,
  },
];
---

<section id="seguridad" class="py-20 lg:py-32 bg-black text-white relative overflow-hidden">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,215,17,0.5) 1px, transparent 0); background-size: 32px 32px;"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16 lg:mb-20">
      <div class="fade-up inline-flex items-center gap-2 bg-primary/10 text-primary px-4 py-2 rounded-full text-sm font-semibold mb-4">
        <span class="w-2 h-2 bg-primary rounded-full"></span>
        Seguridad real, no promesas
      </div>
      <h2 class="fade-up text-3xl sm:text-4xl lg:text-5xl font-black text-white mb-4" style="transition-delay: 0.1s;">
        Viaja con quien <span class="text-primary">opera legalmente</span>
      </h2>
      <p class="fade-up text-lg text-gray-400 max-w-2xl mx-auto" style="transition-delay: 0.2s;">
        A diferencia de plataformas extranjeras, en GO!T cada taxista tiene concesión oficial y opera dentro del marco legal mexicano. Esa es la verdadera seguridad.
      </p>
    </div>

    <!-- Features grid -->
    <div class="grid sm:grid-cols-2 gap-6 lg:gap-8">
      {features.map((feature, index) => (
        <div class="fade-up group" style={`transition-delay: ${index * 0.15}s;`}>
          <div class="bg-white/5 backdrop-blur-sm rounded-3xl p-8 border border-white/10 hover:border-primary/30 hover:bg-white/10 transition-all duration-300 h-full">
            <div class="w-16 h-16 bg-primary/10 rounded-2xl flex items-center justify-center mb-6 text-primary group-hover:bg-primary group-hover:text-black transition-all duration-300">
              <Fragment set:html={feature.icon} />
            </div>
            <h3 class="text-xl font-bold text-white mb-3">{feature.title}</h3>
            <p class="text-gray-400 leading-relaxed">{feature.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Trust badge -->
    <div class="fade-up mt-16 text-center" style="transition-delay: 0.6s;">
      <div class="inline-flex items-center gap-3 bg-white/5 backdrop-blur-sm rounded-full px-6 py-3 border border-white/10">
        <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <span class="text-gray-300 text-sm">Tecnología mexicana comprometida con la legalidad y la seguridad de tu ciudad</span>
      </div>
    </div>
  </div>
</section>
