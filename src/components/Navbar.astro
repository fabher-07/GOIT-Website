---
const navLinks = [
  { href: '#como-funciona', label: 'Cómo funciona' },
  { href: '#pasajeros', label: 'Pasajeros' },
  { href: '#conductores', label: 'Taxistas' },
  { href: '#seguridad', label: 'Seguridad' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-gradient-to-r from-black via-gray-900 to-black backdrop-blur-md border-b border-primary/20 transition-all duration-300" id="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="group">
        <img src="/logo-ride.png" alt="Ride" class="h-8 w-auto object-contain" />
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-8">
        {navLinks.map((link) => (
          <a href={link.href} class="text-sm font-medium text-gray-300 hover:text-primary transition-colors">
            {link.label}
          </a>
        ))}
        <a
          href="#descarga"
          class="bg-primary hover:bg-primary-dark text-black font-bold text-sm px-6 py-2.5 rounded-full transition-all hover:scale-105 active:scale-95"
        >
          Descargar App
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-lg hover:bg-white/10 transition-colors"
        aria-label="Abrir menú"
      >
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Nav -->
    <div id="mobile-menu" class="lg:hidden hidden pb-4">
      <div class="flex flex-col gap-2">
        {navLinks.map((link) => (
          <a href={link.href} class="mobile-nav-link text-gray-300 hover:text-primary hover:bg-white/10 px-4 py-3 rounded-lg font-medium transition-colors">
            {link.label}
          </a>
        ))}
        <a
          href="#descarga"
          class="mobile-nav-link bg-primary hover:bg-primary-dark text-black font-bold text-center px-4 py-3 rounded-full mt-2 transition-all"
        >
          Descargar App
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  (function() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');

    btn?.addEventListener('click', () => {
      const isOpen = !menu?.classList.contains('hidden');
      menu?.classList.toggle('hidden');
      if (isOpen) {
        menuIcon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      } else {
        menuIcon?.setAttribute('d', 'M6 18L18 6M6 6l12 12');
      }
    });

    document.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        menu?.classList.add('hidden');
        menuIcon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      });
    });

    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const navbar = document.getElementById('navbar');
      const currentScroll = window.scrollY;
      if (currentScroll > 100) {
        navbar?.classList.add('shadow-md');
      } else {
        navbar?.classList.remove('shadow-md');
      }
      lastScroll = currentScroll;
    });
  })();
</script>
