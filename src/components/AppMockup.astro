---
// Componente de mockup de la app con ejemplo de viaje
---

<section class="py-20 lg:py-32 bg-gradient-to-b from-white to-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left - Content -->
      <div class="fade-up">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-black mb-6">
          Así se ve un viaje en <span class="text-primary">GO!T</span>
        </h2>
        <p class="text-lg text-gray-600 mb-8">
          Interfaz simple, intuitiva y diseñada para taxistas mexicanos
        </p>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-lg text-black mb-1">Ruta optimizada</h3>
              <p class="text-gray-600">GPS en tiempo real con la mejor ruta para llegar rápido</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-lg text-black mb-1">Tarifa transparente</h3>
              <p class="text-gray-600">El pasajero ve el precio antes de solicitar el viaje</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-primary rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-lg text-black mb-1">Viaje seguro</h3>
              <p class="text-gray-600">Rastreo en tiempo real y botón de emergencia</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right - Phone Mockup -->
      <div class="fade-up flex justify-center lg:justify-end" style="transition-delay: 0.2s;">
        <div class="relative">
          <!-- Phone frame -->
          <div class="relative w-[300px] h-[600px] bg-black rounded-[3rem] p-4 shadow-2xl">
            <!-- Notch -->
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-7 bg-black rounded-b-2xl z-10"></div>
            
            <!-- Screen content -->
            <div class="w-full h-full bg-white rounded-[2.5rem] overflow-hidden">
              <!-- Header -->
              <div class="bg-black text-white p-4 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <img src="/image_logo.png" alt="GO!T" class="w-8 h-8 rounded-lg" />
                  <span class="font-bold">Viaje en curso</span>
                </div>
                <div class="text-primary font-bold">$85</div>
              </div>

              <!-- Map placeholder -->
              <div class="relative h-64 bg-gradient-to-br from-gray-200 to-gray-300">
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="text-center">
                    <div class="text-6xl mb-2">🗺️</div>
                    <p class="text-sm text-gray-600 font-medium">Mapa en tiempo real</p>
                  </div>
                </div>
                <!-- Route line illustration -->
                <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-primary rounded-full animate-pulse"></div>
                <div class="absolute bottom-1/3 right-1/3 w-2 h-2 bg-black rounded-full"></div>
              </div>

              <!-- Trip details -->
              <div class="p-6 space-y-4">
                <div>
                  <div class="flex items-center gap-2 mb-2">
                    <div class="w-3 h-3 bg-primary rounded-full"></div>
                    <span class="text-sm text-gray-600">Origen</span>
                  </div>
                  <p class="font-bold text-black ml-5">Centro Histórico</p>
                </div>

                <div>
                  <div class="flex items-center gap-2 mb-2">
                    <div class="w-3 h-3 bg-black rounded-full"></div>
                    <span class="text-sm text-gray-600">Destino</span>
                  </div>
                  <p class="font-bold text-black ml-5">Zona Angelópolis</p>
                </div>

                <div class="border-t pt-4">
                  <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 bg-gray-200 rounded-full flex items-center justify-center text-xl">
                      👨‍🦳
                    </div>
                    <div>
                      <p class="font-bold text-black">Carlos G.</p>
                      <div class="flex items-center gap-1">
                        <span class="text-primary">⭐</span>
                        <span class="text-sm font-bold">4.9</span>
                      </div>
                    </div>
                  </div>
                  <p class="text-sm text-gray-600">Nissan Tsuru 2020 · ABC-123</p>
                </div>

                <div class="bg-gray-100 rounded-xl p-3 flex items-center justify-between">
                  <span class="text-sm text-gray-600">Distancia</span>
                  <span class="font-bold text-black">4.2 km</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Floating badge -->
          <div class="absolute -right-4 top-1/4 bg-primary text-black font-black px-4 py-2 rounded-full shadow-lg transform rotate-12">
            ¡Fácil!
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
