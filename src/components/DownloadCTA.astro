---

---

<section id="descarga" class="py-20 lg:py-32 bg-white relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-primary/5 rounded-full blur-[100px]"></div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="fade-up bg-gradient-to-br from-black via-gray-900 to-black rounded-[2.5rem] p-10 sm:p-16 relative overflow-hidden">
      <!-- Inner glow -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-primary/20 rounded-full blur-[80px]"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 bg-primary/10 rounded-full blur-[80px]"></div>

      <div class="relative">
        <!-- Logo -->
        <img src="/image_logo.png" alt="Ride" class="w-20 h-20 rounded-2xl mb-8 shadow-lg shadow-primary/30 mx-auto" />

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white mb-4">
          Apoya lo <span class="text-primary">hecho en México</span>
        </h2>
        <p class="text-lg text-gray-400 mb-10 max-w-lg mx-auto">
          Descarga Ride y sé parte del movimiento que devuelve al taxista mexicano el lugar que merece. Tecnología de primer nivel, orgullo nacional.
        </p>

        <!-- Download buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#"
            class="group inline-flex items-center gap-3 bg-white hover:bg-gray-100 text-black px-8 py-4 rounded-2xl transition-all hover:scale-105 active:scale-95 shadow-lg"
          >
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            <div class="text-left">
              <div class="text-xs text-gray-500">Descárgala en</div>
              <div class="text-lg font-bold">App Store</div>
            </div>
          </a>

          <a
            href="#"
            class="group inline-flex items-center gap-3 bg-white hover:bg-gray-100 text-black px-8 py-4 rounded-2xl transition-all hover:scale-105 active:scale-95 shadow-lg"
          >
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 2.302a1 1 0 0 1 0 1.38l-2.302 2.302L15.396 12l2.302-3.492zM5.864 2.658L16.8 8.99l-2.302 2.302L5.864 2.658z"/>
            </svg>
            <div class="text-left">
              <div class="text-xs text-gray-500">Disponible en</div>
              <div class="text-lg font-bold">Google Play</div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
