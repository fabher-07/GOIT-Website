---
const currentYear = new Date().getFullYear();

const legalLinks = [
  { href: '/privacy-policy', label: 'Política de Privacidad' },
  { href: '/terms-of-service', label: 'Términos de Servicio' },
  { href: '/delete-account', label: 'Eliminar Cuenta' },
];

const sectionLinks = [
  { href: '#como-funciona', label: 'Cómo funciona' },
  { href: '#pasajeros', label: 'Pasajeros' },
  { href: '#conductores', label: 'Taxistas' },
  { href: '#seguridad', label: 'Seguridad' },
];
---

<footer class="bg-black text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <img src="/image_logo.png" alt="Ride" class="h-10 w-auto rounded-xl" />
        </div>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          La app 100% mexicana que conecta pasajeros con taxistas legales. Hecha con orgullo en México para México.
        </p>
      </div>

      <!-- Secciones -->
      <div>
        <h3 class="font-bold text-white mb-4">Secciones</h3>
        <ul class="space-y-3">
          {sectionLinks.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-primary text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="font-bold text-white mb-4">Legal</h3>
        <ul class="space-y-3">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-primary text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="font-bold text-white mb-4">Contacto</h3>
        <ul class="space-y-3">
          <li>
            <a href="mailto:soporte@ride-app-taxi.com" class="text-gray-400 hover:text-primary text-sm transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              soporte@ride-app-taxi.com
            </a>
          </li>
          <li>
            <a href="tel:+525624425055" class="text-gray-400 hover:text-primary text-sm transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              56 2442 5055
            </a>
          </li>
          <li class="text-gray-400 text-sm flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            CDMX, México
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-gray-500 text-sm">
        &copy; {currentYear} Ride. Todos los derechos reservados.
      </p>
      <p class="text-gray-500 text-sm">
        Hecho con 💛 y orgullo en México
      </p>
    </div>
  </div>
</footer>
