---

---

<section class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-br from-black via-gray-900 to-black pt-20">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, rgba(255,215,17,0.3) 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <!-- Yellow accent glow -->
  <div class="absolute top-1/4 -right-32 w-96 h-96 bg-primary/20 rounded-full blur-[128px]"></div>
  <div class="absolute bottom-1/4 -left-32 w-96 h-96 bg-primary/10 rounded-full blur-[128px]"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left content -->
      <div class="text-center lg:text-left">
        <!-- Logo -->
        <div class="fade-up inline-flex items-center gap-3 mb-8">
          <img src="/logo-ride.png" alt="Ride" class="w-36 h-24 sm:w-48 sm:h-32" />
        </div>

        <h1 class="fade-up text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black text-white leading-tight mb-6" style="transition-delay: 0.1s;">
          La app
          <span class="text-primary"> 100% mexicana</span>
          del taxi de confianza
        </h1>

        <p class="fade-up text-lg sm:text-xl text-gray-400 mb-10 max-w-lg mx-auto lg:mx-0" style="transition-delay: 0.2s;">
          Hecha en México para los taxistas de México. Porque quienes fueron pioneros del transporte en nuestro país merecen una segunda oportunidad con tecnología de primer nivel.
        </p>

        <!-- Download buttons -->
        <div class="fade-up flex flex-col sm:flex-row gap-4 justify-center lg:justify-start" style="transition-delay: 0.3s;">
          <a
            href="#"
            class="group inline-flex items-center gap-3 bg-white hover:bg-gray-100 text-black px-6 py-4 rounded-2xl transition-all hover:scale-105 active:scale-95 shadow-lg"
          >
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
            </svg>
            <div class="text-left">
              <div class="text-xs text-gray-500">Descárgala en</div>
              <div class="text-base font-bold">App Store</div>
            </div>
          </a>

          <a
            href="#"
            class="group inline-flex items-center gap-3 bg-white hover:bg-gray-100 text-black px-6 py-4 rounded-2xl transition-all hover:scale-105 active:scale-95 shadow-lg"
          >
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 2.302a1 1 0 0 1 0 1.38l-2.302 2.302L15.396 12l2.302-3.492zM5.864 2.658L16.8 8.99l-2.302 2.302L5.864 2.658z"/>
            </svg>
            <div class="text-left">
              <div class="text-xs text-gray-500">Disponible en</div>
              <div class="text-base font-bold">Google Play</div>
            </div>
          </a>
        </div>

        <!-- Stats -->
        <div class="fade-up grid grid-cols-3 gap-6 mt-12 max-w-md mx-auto lg:mx-0" style="transition-delay: 0.4s;">
          <div class="text-center lg:text-left">
            <div class="text-2xl sm:text-3xl font-black text-primary">100%</div>
            <div class="text-xs sm:text-sm text-gray-500">Mexicana</div>
          </div>
          <div class="text-center lg:text-left">
            <div class="text-2xl sm:text-3xl font-black text-primary">Legal</div>
            <div class="text-xs sm:text-sm text-gray-500">Taxistas con concesión</div>
          </div>
          <div class="text-center lg:text-left">
            <div class="text-2xl sm:text-3xl font-black text-primary">24/7</div>
            <div class="text-xs sm:text-sm text-gray-500">Soporte nacional</div>
          </div>
        </div>
      </div>

      <!-- Right - Phone mockup -->
      <div class="fade-up flex justify-center lg:justify-end" style="transition-delay: 0.3s;">
        <div class="relative">
          <!-- Phone frame -->
          <div class="relative w-[280px] sm:w-[320px] h-[560px] sm:h-[640px] bg-black rounded-[3rem] p-3 shadow-2xl shadow-primary/20 border border-gray-800">
            <!-- Notch -->
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-7 bg-black rounded-b-2xl z-10"></div>
            <!-- Screen -->
            <div class="w-full h-full bg-gradient-to-b from-primary/20 via-gray-900 to-gray-900 rounded-[2.4rem] overflow-hidden flex flex-col items-center justify-center">
              <!-- App UI mockup -->
              <img src="/image_logo.png" alt="Ride" class="w-16 h-16 rounded-2xl mb-4 shadow-lg" />
              <div class="text-white font-bold text-lg mb-2">¿A dónde te llevo?</div>
              <div class="w-4/5 bg-white/10 rounded-xl p-3 mb-4">
                <div class="flex items-center gap-2">
                  <div class="w-3 h-3 bg-primary rounded-full"></div>
                  <div class="text-gray-400 text-sm">Buscar destino...</div>
                </div>
              </div>
              <!-- Map placeholder -->
              <div class="w-4/5 flex-1 bg-gray-900 rounded-xl mb-4 overflow-hidden relative">
                <!-- Map background with streets pattern -->
                <div class="absolute inset-0 opacity-20">
                  <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                      <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,215,17,0.3)" stroke-width="0.5"/>
                      </pattern>
                    </defs>
                    <rect width="100%" height="100%" fill="url(#grid)" />
                    <!-- Main streets -->
                    <line x1="0" y1="30%" x2="100%" y2="30%" stroke="rgba(255,215,17,0.4)" stroke-width="2"/>
                    <line x1="0" y1="60%" x2="100%" y2="60%" stroke="rgba(255,215,17,0.4)" stroke-width="2"/>
                    <line x1="40%" y1="0" x2="40%" y2="100%" stroke="rgba(255,215,17,0.4)" stroke-width="2"/>
                    <line x1="70%" y1="0" x2="70%" y2="100%" stroke="rgba(255,215,17,0.4)" stroke-width="2"/>
                  </svg>
                </div>
                <!-- Location markers -->
                <div class="absolute top-1/4 left-1/3 w-6 h-6 bg-primary rounded-full flex items-center justify-center shadow-lg animate-pulse">
                  <div class="w-3 h-3 bg-black rounded-full"></div>
                </div>
                <div class="absolute bottom-1/3 right-1/4 w-6 h-6 bg-red-500 rounded-full flex items-center justify-center shadow-lg">
                  <div class="w-3 h-3 bg-white rounded-full"></div>
                </div>
                <!-- Route line -->
                <svg class="absolute inset-0 w-full h-full" xmlns="http://www.w3.org/2000/svg">
                  <path d="M 33% 25% Q 50% 40%, 75% 66%" stroke="rgba(59, 130, 246, 0.8)" stroke-width="3" fill="none" stroke-dasharray="5,5" stroke-linecap="round"/>
                </svg>
                <!-- Map label -->
                <div class="absolute bottom-2 left-2 bg-black/70 backdrop-blur-sm px-2 py-1 rounded text-xs text-white">
                  📍 CDMX
                </div>
              </div>
              <!-- Bottom bar -->
              <div class="w-4/5 bg-primary rounded-xl p-3 mb-6">
                <div class="text-black font-bold text-center text-sm">Pedir taxi</div>
              </div>
            </div>
          </div>
          <!-- Floating elements -->
          <div class="absolute -top-4 -right-4 bg-primary text-black px-4 py-2 rounded-full font-bold text-sm shadow-lg animate-bounce z-50">
            Hecho en México
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Wave divider -->
  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
      <path d="M0 120L60 110C120 100 240 80 360 70C480 60 600 60 720 65C840 70 960 80 1080 85C1200 90 1320 90 1380 90L1440 90V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="white"/>
    </svg>
  </div>
</section>
