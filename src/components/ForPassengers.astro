---
const benefits = [
  {
    title: 'Tarifas justas y transparentes',
    description: 'Precios claros desde antes de subirte. Sin cobros sorpresa, sin tarifa dinámica. Lo justo para ti y para el taxista.',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
  {
    title: 'Taxistas legales con concesión',
    description: 'Todos nuestros taxistas están legalmente dados de alta en el sistema oficial de México. Concesión vigente y documentos verificados.',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  },
  {
    title: 'Seguimiento en tiempo real',
    description: 'Comparte tu ubicación con tu familia y sigue cada viaje en el mapa. Siempre acompañado, nunca solo.',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
  },
  {
    title: 'Pagos seguros con tarjeta',
    description: 'Paga con tarjeta de crédito o débito directamente en la app. Tecnología segura, sin efectivo.',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>`,
  },
  {
    title: 'Facturación electrónica (CFDI)',
    description: 'Genera tu factura fiscal directamente desde la app. Servicio formal, como debe ser.',
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
  },
];
---

<section id="pasajeros" class="py-20 lg:py-32 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left - Content -->
      <div>
        <div class="fade-up inline-flex items-center gap-2 bg-primary/10 text-black px-4 py-2 rounded-full text-sm font-semibold mb-4">
          <span class="w-2 h-2 bg-primary rounded-full"></span>
          Para ti, pasajero
        </div>
        <h2 class="fade-up text-3xl sm:text-4xl lg:text-5xl font-black text-black mb-6" style="transition-delay: 0.1s;">
          Viaja con quien
          <span class="text-primary"> sí conoce</span> las calles
        </h2>
        <p class="fade-up text-lg text-gray-500 mb-10" style="transition-delay: 0.2s;">
          Los taxistas mexicanos llevan décadas recorriendo cada calle, cada colonia, cada rincón de la ciudad. Con Ride viaja con profesionales que conocen tu ciudad como nadie.
        </p>

        <div class="space-y-5">
          {benefits.map((benefit, index) => (
            <div class="fade-up flex gap-4 group" style={`transition-delay: ${0.2 + index * 0.1}s;`}>
              <div class="flex-shrink-0 w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-primary border border-gray-200 group-hover:bg-primary group-hover:text-black group-hover:border-primary transition-all duration-300 shadow-sm">
                <Fragment set:html={benefit.icon} />
              </div>
              <div>
                <h3 class="font-bold text-black mb-1">{benefit.title}</h3>
                <p class="text-gray-500 text-sm leading-relaxed">{benefit.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right - Visual -->
      <div class="fade-up flex justify-center" style="transition-delay: 0.3s;">
        <div class="relative">
          <!-- Card stack -->
          <div class="w-full max-w-sm">
            <!-- Main card -->
            <div class="bg-white rounded-3xl p-8 shadow-xl border border-gray-100">
              <div class="flex items-center gap-4 mb-6">
                <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </div>
                <div>
                  <div class="font-bold text-black">Carlos M.</div>
                  <div class="text-sm text-gray-400">Taxista con concesión</div>
                </div>
                <div class="ml-auto flex items-center gap-1">
                  <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                  <span class="font-bold text-sm">4.9</span>
                </div>
              </div>

              <!-- Trip info -->
              <div class="space-y-4 mb-6">
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                  <div class="text-sm text-gray-600">Centro Histórico, Puebla</div>
                </div>
                <div class="ml-1.5 w-0.5 h-6 bg-gray-200"></div>
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 bg-primary rounded-full"></div>
                  <div class="text-sm text-gray-600">Angelópolis, Puebla</div>
                </div>
              </div>

              <div class="flex items-center justify-between bg-gray-50 rounded-2xl p-4">
                <div>
                  <div class="text-xs text-gray-400">Tarifa estimada</div>
                  <div class="text-2xl font-black text-black">$85 <span class="text-sm font-normal text-gray-400">MXN</span></div>
                </div>
                <div>
                  <div class="text-xs text-gray-400">Tiempo</div>
                  <div class="text-lg font-bold text-black">15 min</div>
                </div>
              </div>
            </div>

            <!-- Background cards -->
            <div class="absolute -bottom-3 left-4 right-4 h-8 bg-white/60 rounded-3xl border border-gray-100 -z-10"></div>
            <div class="absolute -bottom-6 left-8 right-8 h-8 bg-white/30 rounded-3xl border border-gray-100 -z-20"></div>
          </div>

          <!-- Floating badge -->
          <div class="absolute -top-4 -right-4 bg-green-500 text-white px-4 py-2 rounded-full text-sm font-bold shadow-lg">
            ✓ Verificado
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
